# Plantilla de variables de entorno (copiar a server/.env y completar).
# NUNCA subir valores reales al repositorio.

# Servidor
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/platoya?retryWrites=true&w=majority

# JWT
JWT_SECRET=<secreto-largo-aleatorio-min-32-chars>

# CORS: origen exacto del frontend
CLIENT_ORIGIN=http://localhost:3000

# PayPal Sandbox (solo backend)
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Frontend (publico, sin secretos)
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=<sandbox-client-id-publico>
